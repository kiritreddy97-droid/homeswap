DATABASE_URL=sqlite:///./app.db
# Production: postgresql://user:password@host:5432/dbname

# --- Auth ---
ENV=dev                      # dev | staging | production (production refuses insecure defaults)
JWT_SECRET=                  # required in production: 32+ random chars (e.g. `openssl rand -hex 32`)
JWT_TTL_MINUTES=1440
OTP_SENDER=console           # console logs codes (dev only); add a real provider in app/otp.py
OTP_TTL_MINUTES=10
ADMIN_CONTACTS=              # comma-separated emails/+phones that become admin on login
KYC_WEBHOOK_SECRET=          # HMAC secret for POST /kyc/webhook; webhook is disabled when empty

# --- Limits & logs ---
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
